        </mxCell>
        <mxCell id="15" value="Full ring → pause source reads. Partial send → keep remaining bytes." style="text;html=0;align=center;verticalAlign=top;fontSize=18;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="350" y="387" width="500" height="23" as="geometry" />
        </mxCell>
        <mxCell id="16" value="EOF → drain that ring → shutdown(destination, SHUT_WR)." style="text;html=0;align=center;verticalAlign=top;fontSize=18;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="350" y="422" width="500" height="23" as="geometry" />
        </mxCell>
